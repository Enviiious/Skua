<Window
    x:Class="UltraPlugin.UltraBossWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    Title="Ultra Boss Manager"
    Width="860"
    Height="580"
    MinWidth="640"
    MinHeight="440"
    WindowStartupLocation="CenterScreen"
    ResizeMode="CanResize"
    TextElement.Foreground="{DynamicResource MaterialDesignBody}"
    TextElement.FontFamily="{DynamicResource MaterialDesignFont}"
    Background="{DynamicResource MaterialDesignPaper}">

    <Window.Resources>
        <!-- Defined locally so the plugin window doesn't rely on host-app resources -->
        <BooleanToVisibilityConverter x:Key="BoolVis" />
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="5" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ── Left: Ultra list ─────────────────────────────────────────── -->
        <Grid Grid.Column="0" Margin="10,10,4,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock
                Grid.Row="0"
                Margin="0,0,0,6"
                FontSize="11"
                FontWeight="SemiBold"
                Foreground="{DynamicResource MaterialDesignBodyLight}"
                Text="SELECT ULTRA BOSS" />

            <ListBox
                Grid.Row="1"
                ItemsSource="{Binding Ultras}"
                SelectedItem="{Binding SelectedUltra}"
                ScrollViewer.CanContentScroll="True"
                VirtualizingPanel.IsVirtualizing="True"
                VirtualizingPanel.VirtualizationMode="Recycling"
                Style="{StaticResource MaterialDesignListBox}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock
                            Padding="2,3"
                            Text="{Binding Name}"
                            TextTrimming="CharacterEllipsis" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <GridSplitter
            Grid.Column="1"
            Width="5"
            HorizontalAlignment="Stretch" />

        <!-- ── Right: Configuration panel ──────────────────────────────── -->
        <ScrollViewer
            Grid.Column="2"
            Margin="4,10,10,10"
            VerticalScrollBarVisibility="Auto">

            <StackPanel>

                <!-- Ultra title -->
                <TextBlock
                    FontSize="22"
                    FontWeight="Bold"
                    Foreground="{DynamicResource PrimaryHueMidBrush}"
                    Margin="0,0,0,2"
                    Text="{Binding SelectedUltra.Name, FallbackValue='Select an Ultra Boss'}" />

                <!-- Player count + map -->
                <TextBlock
                    FontSize="11"
                    Foreground="{DynamicResource MaterialDesignBodyLight}"
                    Margin="0,0,0,10">
                    <TextBlock.Text>
                        <MultiBinding StringFormat="{}{0}   ·   Map: {1}">
                            <Binding Path="SelectedUltra.PlayerCount" FallbackValue="" />
                            <Binding Path="SelectedUltra.Map"         FallbackValue="" />
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>

                <Separator Margin="0,0,0,12" />

                <!-- ── Taunter toggle ─────────────────────────────────────── -->
                <StackPanel
                    Orientation="Horizontal"
                    Margin="0,0,0,12"
                    Visibility="{Binding ShowTaunterToggle, Converter={StaticResource BoolVis}}">

                    <ToggleButton
                        Style="{StaticResource MaterialDesignSwitchToggleButton}"
                        IsChecked="{Binding IsTaunter}"
                        Margin="0,0,10,0"
                        VerticalAlignment="Center" />

                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="14"
                        FontWeight="Medium"
                        Text="I am the Taunter" />

                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="11"
                        Foreground="{DynamicResource MaterialDesignBodyLight}"
                        Margin="10,0,0,0">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="({0} taunter(s) needed)">
                                <Binding Path="SelectedUltra.TaunterCount" FallbackValue="0" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </StackPanel>

                <!-- ── Class + Mode row ───────────────────────────────────── -->
                <Grid Visibility="{Binding HasSelectedUltra, Converter={StaticResource BoolVis}}"
                      Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="130" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Class label -->
                    <TextBlock
                        Grid.Column="0" Grid.Row="0"
                        FontSize="11" FontWeight="SemiBold"
                        Foreground="{DynamicResource MaterialDesignBodyLight}"
                        Margin="0,0,0,4"
                        Text="YOUR CLASS" />

                    <!-- Mode label -->
                    <TextBlock
                        Grid.Column="2" Grid.Row="0"
                        FontSize="11" FontWeight="SemiBold"
                        Foreground="{DynamicResource MaterialDesignBodyLight}"
                        Margin="0,0,0,4"
                        Text="MODE" />

                    <!-- Class combo -->
                    <ComboBox
                        Grid.Column="0" Grid.Row="1"
                        IsEditable="True"
                        materialDesign:HintAssist.Hint="Select or type class…"
                        Style="{StaticResource MaterialDesignOutlinedComboBox}"
                        ItemsSource="{Binding AvailableClasses}"
                        Text="{Binding SelectedClass, UpdateSourceTrigger=PropertyChanged}" />

                    <!-- Mode combo -->
                    <ComboBox
                        Grid.Column="2" Grid.Row="1"
                        Style="{StaticResource MaterialDesignOutlinedComboBox}"
                        ItemsSource="{Binding Modes}"
                        SelectedItem="{Binding SelectedMode}" />
                </Grid>

                <!-- ── Role description ───────────────────────────────────── -->
                <Border
                    Margin="0,0,0,12"
                    Padding="14"
                    Background="{DynamicResource MaterialDesignCardBackground}"
                    BorderBrush="{DynamicResource MaterialDesignDivider}"
                    BorderThickness="1"
                    CornerRadius="4">
                    <StackPanel>
                        <TextBlock
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource PrimaryHueMidBrush}"
                            Margin="0,0,0,6"
                            Text="{Binding RoleLabel}" />
                        <TextBlock
                            Text="{Binding RoleDescription}"
                            TextWrapping="Wrap"
                            LineHeight="20" />
                    </StackPanel>
                </Border>

                <!-- ── Mechanics ──────────────────────────────────────────── -->
                <Border
                    Margin="0,0,0,20"
                    Padding="14"
                    Background="{DynamicResource MaterialDesignCardBackground}"
                    BorderBrush="{DynamicResource MaterialDesignDivider}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Visibility="{Binding HasSelectedUltra, Converter={StaticResource BoolVis}}">
                    <StackPanel>
                        <TextBlock
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource MaterialDesignBodyLight}"
                            Margin="0,0,0,6"
                            Text="MECHANICS" />
                        <TextBlock
                            Text="{Binding SelectedUltra.Mechanics}"
                            TextWrapping="Wrap"
                            LineHeight="20" />
                    </StackPanel>
                </Border>

                <!-- ── Buttons ────────────────────────────────────────────── -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Button
                        Content="Start Auto Attack"
                        Command="{Binding StartCommand}"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Margin="0,0,10,0"
                        Width="160" />

                    <Button
                        Content="Stop"
                        Command="{Binding StopCommand}"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Width="90" />
                </StackPanel>

                <!-- Status line -->
                <TextBlock
                    FontSize="11"
                    Foreground="{DynamicResource MaterialDesignBodyLight}"
                    Text="{Binding StatusText}"
                    TextWrapping="Wrap" />

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
