<UserControl
    x:Class="Skua.WPF.UserControls.WikiUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vms="clr-namespace:Skua.Core.ViewModels;assembly=Skua.Core"
    xmlns:wpf="clr-namespace:Skua.WPF"
    d:DataContext="{d:DesignInstance vms:WikiViewModel}"
    d:DesignHeight="600"
    d:DesignWidth="960"
    mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="5" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  Left panel: search + results  -->
        <Grid Grid.Column="0" Margin="8,8,4,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  Search bar  -->
            <DockPanel Grid.Row="0" Margin="0,0,0,4">
                <Button
                    Width="36"
                    Height="36"
                    Command="{Binding SearchCommand}"
                    DockPanel.Dock="Right"
                    Style="{StaticResource MaterialDesignIconButton}"
                    ToolTip="Search (Enter)">
                    <materialDesign:PackIcon Kind="Magnify" />
                </Button>
                <TextBox
                    materialDesign:HintAssist.Hint="Search wiki…"
                    Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                    Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}">
                    <b:Interaction.Behaviors>
                        <wpf:TextBoxSelectAllBehavior />
                    </b:Interaction.Behaviors>
                    <TextBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding SearchCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
            </DockPanel>

            <!--  Status text  -->
            <TextBlock
                Grid.Row="1"
                Margin="0,0,0,4"
                FontSize="11"
                Foreground="{DynamicResource MaterialDesignBodyLight}"
                Text="{Binding StatusText}"
                TextWrapping="Wrap" />

            <!--  Load / Reload wiki button  -->
            <Button
                Grid.Row="2"
                Margin="0,0,0,6"
                Command="{Binding LoadWikiCommand}"
                Content="Load Wiki"
                Style="{StaticResource MaterialDesignOutlinedButton}"
                ToolTip="Load wiki from %AppData%\Skua\aqwwiki_full.json" />

            <!--  Results list  -->
            <ListBox
                Grid.Row="3"
                ItemsSource="{Binding SearchResults}"
                ScrollViewer.CanContentScroll="True"
                SelectedItem="{Binding SelectedPage}"
                VirtualizingPanel.IsVirtualizing="True"
                VirtualizingPanel.VirtualizationMode="Recycling">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock
                            Padding="2,1"
                            Text="{Binding Title}"
                            TextTrimming="CharacterEllipsis" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <GridSplitter
            Grid.Column="1"
            Width="5"
            HorizontalAlignment="Stretch" />

        <!--  Right panel: page detail  -->
        <Grid Grid.Column="2" Margin="4,8,8,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  Page title  -->
            <TextBlock
                Grid.Row="0"
                Margin="0,0,0,2"
                FontSize="20"
                FontWeight="SemiBold"
                Foreground="{DynamicResource PrimaryHueMidBrush}"
                Text="{Binding PageTitle}"
                TextTrimming="CharacterEllipsis"
                Visibility="{Binding HasPage, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <!--  Tags  -->
            <TextBlock
                Grid.Row="1"
                Margin="0,0,0,8"
                FontSize="11"
                Foreground="{DynamicResource MaterialDesignBodyLight}"
                Text="{Binding PageTags}"
                TextWrapping="Wrap"
                Visibility="{Binding HasPage, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <!--  Structured page content (FlowDocument built in code-behind)  -->
            <Border
                Grid.Row="2"
                Background="{DynamicResource MaterialDesignCardBackground}"
                BorderBrush="{DynamicResource MaterialDesignDivider}"
                BorderThickness="1"
                CornerRadius="4">
                <RichTextBox
                    x:Name="WikiContent"
                    Padding="12"
                    Background="Transparent"
                    BorderThickness="0"
                    FontFamily="Segoe UI"
                    FontSize="13"
                    Foreground="{DynamicResource MaterialDesignBody}"
                    IsReadOnly="True"
                    IsDocumentEnabled="True"
                    VerticalScrollBarVisibility="Auto" />
            </Border>

            <!--  Footer: URL + open button  -->
            <DockPanel
                Grid.Row="3"
                Margin="0,8,0,0"
                Visibility="{Binding HasPage, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Button
                    Command="{Binding OpenInBrowserCommand}"
                    Content="Open in Browser"
                    DockPanel.Dock="Right"
                    Style="{StaticResource MaterialDesignOutlinedButton}" />
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="11"
                    Foreground="{DynamicResource MaterialDesignBodyLight}"
                    Text="{Binding PageUrl}"
                    TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>
