<UserControl
    x:Class="Skua.WPF.UserControls.CBOClassEquipmentUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Skua.WPF.UserControls"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vms="clr-namespace:Skua.Core.ViewModels;assembly=Skua.Core"
    d:DataContext="{d:DesignInstance vms:CBOClassEquipmentViewModel}"
    d:DesignHeight="320"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <UserControl.Resources>
        <Style BasedOn="{StaticResource MaterialDesignComboBox}" TargetType="ComboBox">
            <Setter Property="Margin" Value="0,3" />
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>

        <!-- Refresh button spans both columns -->
        <Button
            Grid.ColumnSpan="2"
            Command="{Binding RefreshOutfitsCommand}"
            Content="Refresh Outfits" />

        <!-- Solo -->
        <GroupBox
            Grid.Row="1"
            Grid.Column="0"
            Margin="0,6,3,0"
            Header="Solo Class">
            <StackPanel>
                <ComboBox
                    DropDownOpened="ComboBox_DropDownOpened"
                    materialDesign:HintAssist.Hint="Outfit"
                    ItemsSource="{Binding Outfits}"
                    SelectedItem="{Binding SelectedSoloOutfit}" />
                <ComboBox
                    materialDesign:HintAssist.Hint="Mode"
                    ItemsSource="{Binding SoloUseModes}"
                    SelectedItem="{Binding SelectedSoloUseMode}" />
            </StackPanel>
        </GroupBox>

        <!-- Farm -->
        <GroupBox
            Grid.Row="1"
            Grid.Column="1"
            Margin="3,6,0,0"
            Header="Farm Class">
            <StackPanel>
                <ComboBox
                    DropDownOpened="ComboBox_DropDownOpened"
                    materialDesign:HintAssist.Hint="Outfit"
                    ItemsSource="{Binding Outfits}"
                    SelectedItem="{Binding SelectedFarmOutfit}" />
                <ComboBox
                    materialDesign:HintAssist.Hint="Mode"
                    ItemsSource="{Binding FarmUseModes}"
                    SelectedItem="{Binding SelectedFarmUseMode}" />
            </StackPanel>
        </GroupBox>

        <!-- Dodge -->
        <GroupBox
            Grid.Row="2"
            Grid.Column="0"
            Margin="0,6,3,0"
            Header="Dodge Class">
            <StackPanel>
                <ComboBox
                    DropDownOpened="ComboBox_DropDownOpened"
                    materialDesign:HintAssist.Hint="Outfit"
                    ItemsSource="{Binding Outfits}"
                    SelectedItem="{Binding SelectedDodgeOutfit}" />
                <ComboBox
                    materialDesign:HintAssist.Hint="Mode"
                    ItemsSource="{Binding DodgeUseModes}"
                    SelectedItem="{Binding SelectedDodgeUseMode}" />
            </StackPanel>
        </GroupBox>

        <!-- Boss -->
        <GroupBox
            Grid.Row="2"
            Grid.Column="1"
            Margin="3,6,0,0"
            Header="Boss Class">
            <StackPanel>
                <ComboBox
                    DropDownOpened="ComboBox_DropDownOpened"
                    materialDesign:HintAssist.Hint="Outfit"
                    ItemsSource="{Binding Outfits}"
                    SelectedItem="{Binding SelectedBossOutfit}" />
                <ComboBox
                    materialDesign:HintAssist.Hint="Mode"
                    ItemsSource="{Binding BossUseModes}"
                    SelectedItem="{Binding SelectedBossUseMode}" />
            </StackPanel>
        </GroupBox>
    </Grid>
</UserControl>
